{
  "name": "bobuttons",
  "version": "0.1.0",
  "description": "Private React (Tamagui) component library with Storybook as the review and design surface.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.native.js"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./icons/animal": {
      "react-native": {
        "types": "./dist/icons/animal.d.ts",
        "default": "./dist/icons/animal.native.js"
      },
      "import": {
        "types": "./dist/icons/animal.d.mts",
        "default": "./dist/icons/animal.mjs"
      },
      "require": {
        "types": "./dist/icons/animal.d.cts",
        "default": "./dist/icons/animal.cjs"
      }
    },
    "./icons/basic": {
      "react-native": {
        "types": "./dist/icons/basic.d.ts",
        "default": "./dist/icons/basic.native.js"
      },
      "import": {
        "types": "./dist/icons/basic.d.mts",
        "default": "./dist/icons/basic.mjs"
      },
      "require": {
        "types": "./dist/icons/basic.d.cts",
        "default": "./dist/icons/basic.cjs"
      }
    },
    "./icons/food": {
      "react-native": {
        "types": "./dist/icons/food.d.ts",
        "default": "./dist/icons/food.native.js"
      },
      "import": {
        "types": "./dist/icons/food.d.mts",
        "default": "./dist/icons/food.mjs"
      },
      "require": {
        "types": "./dist/icons/food.d.cts",
        "default": "./dist/icons/food.cjs"
      }
    },
    "./icons/shapes": {
      "react-native": {
        "types": "./dist/icons/shapes.d.ts",
        "default": "./dist/icons/shapes.native.js"
      },
      "import": {
        "types": "./dist/icons/shapes.d.mts",
        "default": "./dist/icons/shapes.mjs"
      },
      "require": {
        "types": "./dist/icons/shapes.d.cts",
        "default": "./dist/icons/shapes.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "react-native": "./dist/index.native.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build-storybook": "storybook build",
    "storybook": "storybook dev -p 6006",
    "lint": "eslint .",
    "typecheck:bundler": "tsc --noEmit -p tsconfig.typecheck.bundler.json",
    "typecheck:node16": "tsc --noEmit -p tsconfig.typecheck.node16.json",
    "typecheck:native:bundler": "tsc --noEmit -p tsconfig.typecheck.native.bundler.json",
    "typecheck:native:node16": "tsc --noEmit -p tsconfig.typecheck.native.node16.json",
    "generate-themes": "node scripts/generate-themes.mjs",
    "generate-themes:write": "node scripts/generate-themes.mjs --write",
    "generate-icon-packs": "node scripts/generate-icon-packs.mjs",
    "generate-icon-packs:write": "node scripts/generate-icon-packs.mjs --write",
    "test": "vitest run",
    "pack": "npm run build && mkdir -p .verify-out && npm pack --ignore-scripts --pack-destination .verify-out --json",
    "prepack": "npm run build",
    "prepublishOnly": "node -e \"console.error('Bobuttons is private and must never be published.'); process.exit(1)\"",
    "verify": "node scripts/verify.mjs",
    "verify:native": "node scripts/check-native-bundle.mjs"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "react-native": ">=0.79 <1.0",
    "react-native-svg": ">=15.0.0 <16.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native/metro-config": "0.79.6",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tamagui/core": "3.0.18",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "eslint": "10.13.0",
    "fast-glob": "3.3.3",
    "griddy-icons": "0.2.0",
    "jsdom": "27.0.0",
    "lucide": "1.72.0",
    "metro": "0.82.5",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.79.6",
    "react-native-svg": "15.15.5",
    "storybook": "10.6.2",
    "tsup": "8.5.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
